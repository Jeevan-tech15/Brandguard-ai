# ==============================================================================
# BrandGuard AI Environment Variables
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Gemini AI Configuration (Optional - Engine features robust local deterministic fallback)
# ------------------------------------------------------------------------------
# GEMINI_API_KEY: API key for Gemini multimodal vision and audit evaluations.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_API_URL: (Optional) Custom endpoint or proxy URL for Gemini API calls.
# e.g. "https://generativelanguage.googleapis.com" or your custom reverse proxy / enterprise endpoint.
GEMINI_API_URL="https://generativelanguage.googleapis.com"

# ------------------------------------------------------------------------------
# 2. Application & Hosting Configuration
# ------------------------------------------------------------------------------
# APP_URL: The public URL where this applet is hosted.
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 3. Supabase Credentials (Database & Audit Persistence)
# If provided, BrandGuard syncs all reviews, guidelines, facts, and assets to Supabase PostgreSQL.
# If omitted, BrandGuard seamlessly uses the active local persistent store (.data/db.json).
# ------------------------------------------------------------------------------
# NEXT_PUBLIC_SUPABASE_URL: Your Supabase project URL (from Project Settings -> API)
# e.g. "https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"

# NEXT_PUBLIC_SUPABASE_ANON_KEY: Your Supabase anonymous public key (anon / public)
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"

# SUPABASE_SERVICE_ROLE_KEY: (Optional server-side only) Your Supabase service role secret key
# Grants full administrative access to bypass Row Level Security (RLS) for backend operations.
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Alternative aliases supported on the server:
# SUPABASE_URL="https://your-project-id.supabase.co"
# SUPABASE_ANON_KEY="your-supabase-anon-key"
